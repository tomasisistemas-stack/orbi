      'var'
      '  sDesconto : Double;'
      '  sMargem   : Double;'
      '  sRegistros : integer;'
      ''
      '  sDescontoGeral : Double;'
      '  sMargemGeral   : Double;'
      '  sRegistrosGeral : integer;'
      ' '
      '  ZebraFlag: Integer;'
      ''
      'procedure ReportOnStartReport(Sender: TfrxComponent);'
      'begin'
      '  ZebraFlag := 0;'
      'end;  '
      ''
      '  '
      'procedure GroupHeader1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  if <TipUsu> = '#39'9'#39' then'
      '    mmMLTT.memo.text := '#39'% Mrg'#39
      '  else'
      '    mmMLTT.memo.text := '#39'% Dsc'#39';'
      ''
      '  sDesconto  := 0;'
      '  sMargem    := 0;'
      '  sRegistros := 0;'
      'end;'
      ''
      'procedure DetailData1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  if <TipUsu> = '#39'9'#39' then'
      '    mmMLDT.memo.text:= <dst_vendas1."MARGEM">'
      '  else'
      '    mmMLDT.memo.text:= <dst_vendas1."desconto">;'
      ''
      '  sDesconto := sDesconto + <dst_vendas1."desconto">;'
      '  sMargem   := sMargem   + <dst_vendas1."MARGEM">;'
      '  sRegistros := sRegistros + 1;'
      ''
      '  if Sender is TfrxBand then'
      '  begin'
      '    ZebraFlag := ZebraFlag + 1;'
      '    with TfrxMasterData(Sender) do'
      '    begin'
      '      if (ZebraFlag mod 2) = 0 then'
      '        TfrxBrushFill(Fill).BackColor := $00E0E0E0'
      '      else'
      '        TfrxBrushFill(Fill).BackColor := clwhite;'
      '    end;'
      '  end;  '
      'end;'
      ''
      'procedure GroupFooter1OnBeforePrint(Sender: TfrxComponent);'
      'var v: Variant;'
      'begin'
      '  if <TipUsu> = '#39'9'#39' then'
      '    v := sDesconto / sRegistros'
      '  else'
      '    v := sMargem / sRegistros;'
      ''
      '  if <TipUsu> = '#39'9'#39' then'
      
        '    mmMLGF.Text := '#39'Margem de Lucro: '#39' + FormatFloat('#39'0.00'#39', v) ' +
        '+ '#39'%'#39
      '  else'
      '    mmMLGF.Text := '#39'Desconto: '#39' + FormatFloat('#39'0.00'#39', v) + '#39'%'#39';'
      ''
      '  sDescontoGeral  := sDescontoGeral  + sDesconto;'
      '  sMargemGeral    := sMargemGeral    + sMargem;'
      '  sRegistrosGeral := sRegistrosGeral + sRegistros;'
      'end;'
      ''
      'procedure ReportSummary1OnBeforePrint(Sender: TfrxComponent);'
      'var v: Variant;'
      'begin'
      '  if <TipUsu> = '#39'9'#39' then'
      '    v := sDescontoGeral / sRegistrosGeral'
      '  else'
      '    v := sMargemGeral / sRegistrosGeral;'
      ''
      '  if <TipUsu> = '#39'9'#39' then'
      
        '    mmMLRS.Text := '#39'Margem de Lucro: '#39' + FormatFloat('#39'0.00'#39', v) ' +
        '+ '#39'%'#39
      '  else'
      '    mmMLRS.Text := '#39'Desconto: '#39' + FormatFloat('#39'0.00'#39', v) + '#39'%'#39';'
      'end;'
      ''
      'procedure Page1OnBeforePrint(Sender: TfrxComponent);'
      'begin'
      '  sDescontoGeral  := 0;'
      '  sMargemGeral    := 0;'
      '  sRegistrosGeral := 0;'
      'end;'
      ''
      'begin'
      ''
      'end.')
