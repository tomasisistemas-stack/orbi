    ReportOptions.LastChange = 45692.714142650500000000
    ScriptLanguage = 'PascalScript'
    ScriptText.Strings = (
      
        'procedure DadosProdutosHeaderOnBeforePrint(Sender: TfrxComponent' +
        ');'
      'begin'
      '  if Engine.FinalPass then'
